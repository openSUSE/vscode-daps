{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [["{", "}"], ["(", ")"]],
  "autoClosingPairs": [
    { "open": "\"", "close": "\"", "notIn": ["comment"] },
    { "open": "'", "close": "'", "notIn": ["comment", "string"] },
    { "open": "{", "close": "}" },
    { "open": "(", "close": ")" }
  ],
  "surroundingPairs": [["\"", "\""], ["'", "'"], ["{", "}"], ["(", ")"]]
}
